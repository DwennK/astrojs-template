{
  "name": "astro-cloudflare-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:worker": "pnpm run build && wrangler dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:worker": "pnpm run build && wrangler dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "test:worker": "vitest run",
    "wrangler:types": "wrangler types",
    "wrangler:types:check": "wrangler types --check",
    "check:links": "node scripts/check-links.mjs dist",
    "test:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "deploy:dry-run": "wrangler deploy --dry-run --env production",
    "deploy:preview": "pnpm run build && wrangler deploy --env preview",
    "deploy:production": "pnpm run build && wrangler deploy --env production",
    "quality": "pnpm run format:check && pnpm run check && pnpm run typecheck && pnpm run test:worker && pnpm run wrangler:types:check && pnpm run build && pnpm run check:links && pnpm run test:smoke && pnpm run test:a11y && pnpm run deploy:dry-run"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.143",
    "@iconify-json/simple-icons": "^1.2.100",
    "astro": "^7.3.8",
    "astro-icon": "^1.2.0",
    "schema-dts": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-plugin": "^1.4.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  },
  "packageManager": "pnpm@12.11.2"
}
